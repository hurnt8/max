# Bloque l'accès direct aux fichiers/dossiers sensibles quand le document root
# pointe sur la racine du projet plutôt que sur /public (hébergement mutualisé).
<FilesMatch "^\.(env.*|git.*|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers publics du disque "public" (logos, médias téléversés) :
    # /storage/xxx est servi depuis storage/app/public/xxx, sans lien symbolique.
    # Le reste de storage/ (logs, sessions, cache, privé) reste interdit ci-dessous.
    # Seules les extensions de médias/documents sont servies (jamais de .php, .env, etc.).
    RewriteRule ^storage/app/public/.+\.(?:png|jpe?g|gif|webp|svg|ico|avif|pdf|docx?|xlsx?|txt|mp4|mp3)$ - [L,NC]
    RewriteRule ^storage/(?!app/|framework/|logs/)(.+\.(?:png|jpe?g|gif|webp|svg|ico|avif|pdf|docx?|xlsx?|txt|mp4|mp3))$ storage/app/public/$1 [L,NC]

    # Dossiers du code source Laravel — jamais servis directement
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^$1 [N]

    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ public/$1

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ server.php

</IfModule>